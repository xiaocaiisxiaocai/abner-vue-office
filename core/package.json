{
  "name": "abner-vue-office",
  "version": "1.0.0",
  "description": "通过Vue开发的办公文档预览组件，支持docx、pdf、ppt、excel(已实现)的预览",
  "scripts": {
    "dev": "node script/bak-vue.js && vite",
    "build": "node script/bak-vue.js && vite build",
    "test": "node --test tests/*.test.mjs",
    "lib": "node script/run-lib.js --concurrency=1",
    "lib:js-excel": "node script/run-lib.js --scope @abner-vue-office/js-excel",
    "lib:js-docx": "node script/run-lib.js --scope @abner-vue-office/js-docx",
    "lib:vue-excel": "node script/run-lib.js --scope @abner-vue-office/excel",
    "lib:vue-docx": "node script/run-lib.js --scope @abner-vue-office/docx",
    "lib:js-pdf": "node script/run-lib.js --scope @abner-vue-office/js-pdf",
    "lib:vue-pdf": "node script/run-lib.js --scope @abner-vue-office/pdf",
    "lib:vue-pptx": "node script/run-lib.js --scope @abner-vue-office/pptx"
  },
  "dependencies": {
    "@babel/plugin-transform-runtime": "^7.23.6",
    "@babel/plugin-transform-template-literals": "^7.23.3",
    "@babel/preset-env": "^7.22.5",
    "@babel/runtime": "^7.23.6",
    "@rollup/plugin-babel": "^6.0.3",
    "@vue/compiler-sfc": "3.2.45",
    "ant-design-vue": "^3.2.17",
    "core-js": "^3.37.1",
    "dayjs": "^1.11.7",
    "docx-preview": "^0.3.2",
    "exceljs": "^4.3.0",
    "lodash": "^4.17.21",
    "postcss": "^8.4.24",
    "pptx-preview": "^0.0.19",
    "rimraf": "^4.1.2",
    "rollup": "^3.26.0",
    "tinycolor2": "^1.6.0",
    "vue-demi": "^0.14.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.2",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-terser": "^0.4.3",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/composition-api": "^1.7.1",
    "eslint": "^8.36.0",
    "eslint-plugin-vue": "^9.9.0",
    "lerna": "^6.4.1",
    "less": "^4.1.3",
    "terser": "^5.31.0",
    "vite": "^4.0.0",
    "vite-plugin-vue2": "^2.0.3",
    "vue": "3.2.45",
    "vue-router": "4.4.5",
    "vue-template-compiler": "2.6.14",
    "vue2": "npm:vue@2.6.14",
    "vue3": "npm:vue@3.2.45"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "vue",
    "docx",
    "pdf",
    "ppt",
    "excel",
    "docx-preview",
    "excel-preview",
    "pdf-preview"
  ],
  "license": "MIT",
  "author": "abner"
}
