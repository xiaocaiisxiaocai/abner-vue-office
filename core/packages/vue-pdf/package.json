{
  "name": "@abner-vue-office/pdf",
  "version": "1.0.0",
  "description": "",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "copyFile2": "node ../../script/copy.js lib/v2/abner-vue-office-pdf.umd.js lib/v2/index.js",
    "copyFile3": "node ../../script/copy.js lib/v3/abner-vue-office-pdf.umd.js lib/v3/index.js",
    "copyReadme": "node ../../script/copy.js ../../../README.md README.md",
    "copyType": "node ../../script/copy.js index.d.ts lib/index.d.ts",
    "copyScripts": "node ../../script/copy.js ../../script/postinstall.js lib/script/postinstall.js ../../script/switch-cli.js lib/script/switch-cli.js ../../script/utils.js lib/script/utils.js",
    "build:2": "npx vue-demi-switch 2 vue2 && vite build && npm run copyFile2",
    "build:3": "npx vue-demi-switch 3 vue3 && vite build && npm run copyFile3",
    "build": "npm run clean && npm run build:2 && npm run build:3 && npm run copyScripts && npm run copyReadme && npm run copyType",
    "postinstall": "node -e \"if(require('fs').existsSync('lib/script/postinstall.js'))require('./lib/script/postinstall.js')\""
  },
  "peerDependencies": {
    "@vue/composition-api": "^1.7.1",
    "vue": "^2.0.0 || >=3.0.0",
    "vue-demi": "^0.14.6"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "keywords": [
    "vue",
    "docx",
    "pdf",
    "ppt",
    "excel",
    "docx-preview",
    "excel-preview",
    "pdf-preview"
  ],
  "license": "MIT",
  "author": "abner",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
