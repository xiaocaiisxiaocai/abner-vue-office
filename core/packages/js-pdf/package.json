{
  "name": "@abner-vue-office/js-pdf",
  "type" :"module",
  "version": "1.0.0",
  "description": "不依赖前端框架的原生 JavaScript pdf 文件预览库",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./umd": "./lib/index.umd.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "copyReadme": "node ../../script/copy.js ../../../README.md README.md",
    "copyType": "node ../../script/copy.js index.d.ts lib/index.d.ts",
    "copy": "npm run copyType && npm run copyReadme",
    "build": "npm run clean && rollup --config rollup.config.js && npm run copy"
  },
  "keywords": [
    "javascript",
    "pdf",
    "pdf-preview",
    "office-preview"
  ],
  "license": "MIT",
  "author": "abner",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
  }
}
