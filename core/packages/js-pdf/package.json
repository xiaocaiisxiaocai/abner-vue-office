{
  "name": "@abner-vue-office/js-pdf",
  "type": "module",
  "version": "1.0.0",
  "description": "不依赖前端框架的原生 JavaScript pdf 文件预览库",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      },
      "default": "./lib/index.js"
    },
    "./umd": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.umd.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "copyReadme": "node ../../script/copy.js ../../../README.md README.md",
    "copyLicense": "node ../../script/copy.js ../../LICENSE LICENSE",
    "copyType": "node ../../script/copy.js index.d.ts lib/index.d.ts index.d.cts lib/index.d.cts",
    "copy": "npm run copyType && npm run copyReadme && npm run copyLicense",
    "build": "npm run clean && rollup --config rollup.config.js && npm run copy",
    "prepublishOnly": "node -e \"const fs=require('fs');const req=['lib/index.js','lib/index.cjs','lib/index.umd.js','lib/index.d.ts','lib/index.d.cts','README.md','LICENSE'];const miss=req.filter(f=>!fs.existsSync(f));if(miss.length){console.error('Missing artifacts:',miss);process.exit(1);}\""
  },
  "keywords": [
    "javascript",
    "pdf",
    "pdf-preview",
    "office-preview"
  ],
  "license": "MIT",
  "author": "abner",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaocaiisxiaocai/abner-vue-office.git",
    "directory": "core/packages/js-pdf"
  },
  "homepage": "https://github.com/xiaocaiisxiaocai/abner-vue-office#readme",
  "bugs": {
    "url": "https://github.com/xiaocaiisxiaocai/abner-vue-office/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {}
}
