{
  "name": "@abner-vue-office/excel",
  "version": "1.0.0",
  "description": "基于 Vue 的 excel (xlsx/xls) 文件预览组件（支持 Vue 2 / Vue 3）",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/index.css": "./lib/index.css",
    "./lib/v2": "./lib/v2/index.js",
    "./lib/v2/index.css": "./lib/v2/index.css",
    "./lib/v3": "./lib/v3/index.js",
    "./lib/v3/index.css": "./lib/v3/index.css",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "copyFile2": "node ../../script/copy.js src/index.css lib/v2/index.css",
    "copyFile3": "node ../../script/copy.js src/index.css lib/v3/index.css",
    "copyDefault": "node ../../script/copy.js lib/v3/index.js lib/index.js lib/v3/index.css lib/index.css",
    "copyReadme": "node ../../script/copy.js ../../../README.md README.md",
    "copyType": "node ../../script/copy.js index.d.ts lib/index.d.ts",
    "copyScripts": "node ../../script/copy.js ../../script/postinstall.js lib/script/postinstall.js ../../script/switch-cli.js lib/script/switch-cli.js ../../script/utils.js lib/script/utils.js",
    "build:2": "npx vue-demi-switch 2 vue2 && vite build && npm run copyFile2",
    "build:3": "npx vue-demi-switch 3 vue3 && vite build && npm run copyFile3",
    "build": "npm run clean && npm run build:2 && npm run build:3 && npm run copyDefault && npm run copyScripts && npm run copyReadme && npm run copyType",
    "postinstall": "node -e \"if(require('fs').existsSync('lib/script/postinstall.js'))require('./lib/script/postinstall.js')\""
  },
  "peerDependencies": {
    "@vue/composition-api": "^1.7.1",
    "vue": "^2.0.0 || >=3.0.0",
    "vue-demi": "^0.14.6"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "vue-demi",
    "excel",
    "xlsx",
    "xls",
    "excel-preview",
    "office-preview"
  ],
  "license": "MIT",
  "author": "abner",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
