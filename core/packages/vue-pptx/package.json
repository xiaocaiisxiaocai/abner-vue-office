{
  "name": "@abner-vue-office/pptx",
  "version": "1.0.0",
  "description": "基于 Vue 的 pptx 文件预览组件（支持 Vue 2 / Vue 3）",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/v2": {
      "types": "./lib/v2/index.d.ts",
      "default": "./lib/v2/index.js"
    },
    "./lib/v3": {
      "types": "./lib/v3/index.d.ts",
      "default": "./lib/v3/index.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "abner-vue-office-pptx-switch": "lib/script/switch-cli.js"
  },
  "files": [
    "lib/",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "copyDefault": "node ../../script/copy.js lib/v3/index.js lib/index.js",
    "copyReadme": "node ../../script/copy.js ../../../README.md README.md",
    "copyLicense": "node ../../script/copy.js ../../LICENSE LICENSE",
    "copyType": "node ../../script/copy.js index.d.ts lib/index.d.ts index.d.ts lib/v2/index.d.ts index.d.ts lib/v3/index.d.ts",
    "copyScripts": "node ../../script/copy.js ../../script/postinstall.js lib/script/postinstall.js ../../script/switch-cli.js lib/script/switch-cli.js ../../script/utils.js lib/script/utils.js",
    "build:2": "npx vue-demi-switch 2 vue2 && vite build",
    "build:3": "npx vue-demi-switch 3 vue3 && vite build",
    "build": "npm run clean && npm run build:2 && npm run build:3 && npm run copyDefault && npm run copyScripts && npm run copyReadme && npm run copyLicense && npm run copyType",
    "postinstall": "node -e \"if(require('fs').existsSync('lib/script/postinstall.js'))require('./lib/script/postinstall.js')\"",
    "prepublishOnly": "node -e \"const fs=require('fs');const req=['lib/index.js','lib/v2/index.js','lib/v3/index.js','lib/index.d.ts','lib/v2/index.d.ts','lib/v3/index.d.ts','lib/script/postinstall.js','lib/script/switch-cli.js','lib/script/utils.js','README.md','LICENSE'];const miss=req.filter(f=>!fs.existsSync(f));if(miss.length){console.error('Missing artifacts:',miss);process.exit(1);}\""
  },
  "peerDependencies": {
    "@vue/composition-api": "^1.7.1",
    "vue": "^2.6.0 || >=3.0.0",
    "vue-demi": "^0.14.6"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "vue-demi",
    "pptx",
    "ppt",
    "pptx-preview",
    "office-preview"
  ],
  "license": "MIT",
  "author": "abner",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaocaiisxiaocai/abner-vue-office.git",
    "directory": "core/packages/vue-pptx"
  },
  "homepage": "https://github.com/xiaocaiisxiaocai/abner-vue-office#readme",
  "bugs": {
    "url": "https://github.com/xiaocaiisxiaocai/abner-vue-office/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
